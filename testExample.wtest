import victoria.*

describe "Grupo de pruebas de Victoria" {

  test "Victoria mide 150cm, practica judo (necesita un traje de judo), tiene 4 entrenadores" {
    victoria.nuevaAltura(150)
    victoria.disciplina(judo)
    victoria.entrenadores(4)
    assert.equal(9500, victoria.presupuesto() )
  }

}